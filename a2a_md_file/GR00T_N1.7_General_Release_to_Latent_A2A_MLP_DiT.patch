+def _should_log_step_metrics(
+    global_step: int,
+    logging_steps: int | float | None,
+    last_logged_step: int | None,
+) -> bool:
+    """Return whether per-step metrics should be emitted exactly once.
+
+    ``compute_loss`` may run several times at one optimizer step under gradient
+    accumulation. Step zero is likewise visited once per micro-batch, so it is
+    deliberately excluded.
